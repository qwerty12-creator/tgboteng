# Токен бота из @BotFather (обязательно)
BOT_TOKEN=***

# Часовой пояс для "дней практики" и стриков (смещение от UTC в часах, Москва = 3)
TZ_OFFSET=3

# Путь к файлу базы данных (по умолчанию ./data/lingo.db)
DB_PATH=./data/lingo.db

# --- Режим AI Conversation ---
# Если ключ не задан, бот работает на встроенном офлайн-собеседнике.
# Поддерживается любой OpenAI-совместимый API.
AI_API_KEY=***
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Таймаут запроса к нейросети, мс
AI_TIMEOUT_MS=25000

# --- Голосовые: локальное распознавание речи (whisper.cpp + ffmpeg) ---
# Ключи и интернет не нужны. Пустые значения = пути по умолчанию:
#   whisper/Release/whisper-cli.exe и whisper/models/ggml-medium-q5_0.bin
#   (если папки нет в проекте, берётся ../ds-bot/whisper/...)
WHISPER_EXE=
WHISPER_MODEL=
# Язык: auto (определять самому), ru или en
WHISPER_LANG=auto
# Потоков CPU для whisper (по умолчанию min(4, ядра))
WHISPER_THREADS=
# Таймаут распознавания, мс (medium-модель считает ~1.5x от длины записи)
WHISPER_TIMEOUT_MS=600000
# ffmpeg (по умолчанию из PATH)
FFMPEG=ffmpeg

# --- Голосовые: облачное распознавание (DeepSeek ASR) ---
# Нужно, когда локального whisper.cpp нет (например, на Render в Linux).
# Принимает audio/ogg (Opus) — формат телеграм-голосовых, — и 16-bit PCM WAV.
# Если локальный whisper найден, используется он: облако не тратится.
STT_API_KEY=
# Base URL ASR и путь метода (DeepSeek: /v1/tools/asr)
STT_BASE_URL=https://api.deepseek.com/v1
STT_API_PATH=/tools/asr
# Лимиты сервиса: 8 МиБ и 120 секунд на файл
STT_MAX_BYTES=8388608
STT_MAX_SECONDS=120
# Таймаут запроса к ASR, мс
STT_API_TIMEOUT_MS=120000

# --- Сохранность базы: репликация в Cloudflare R2 через Litestream ---
# Нужно только в облаке (Render), где диск контейнера стирается при редеплое.
# Локально оставь пустым: бот просто пишет в data/lingo.db.
LITESTREAM_BUCKET=
# Папка внутри бакета
LITESTREAM_PREFIX=lingo
# S3-endpoint: https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
